#define __NR_setuid				105
#define __NR_setgid				106
#define __NR_geteuid			107
#define __NR_getegid			108
/* OxideBSD's own invention (120), continuing the sequence right past rt_sigreturn (119) -- but
 * matches real setpgid(2)'s exact (pid, pgid) wire format, same "no argument-convention patch
 * needed" story kill/rt_sigaction/rt_sigprocmask above already have. Left at its original value
 * (109) this would silently collide with OxideBSD's own real unlink -- harmless only because
 * nothing called setpgid before this. No permission/session checks on the OxideBSD side (no uid
 * model at all yet) -- see src/process.rs's do_setpgid in the OxideBSD tree. A real, if narrow,
 * numeric collision this remap itself introduces: getresgid's own untouched-from-Linux value is
 * also 120 -- no caller in this port reaches getresgid, so this hasn't bitten anything, but it
 * would silently land on setpgid's own handler instead of cleanly failing if one ever did (the
 * same kind of "flagged, not fixed, since nothing reaches it yet" collision open's own remap once
 * left for fstat, until stat/fstat/lstat actually got real numbers of their own -- see the
 * stat/fstat/lstat remap near the top of this file). */
#define __NR_setpgid			120
/* OxideBSD's own invention (107, not a FreeBSD-authentic number), added for the same reason and at
 * the same time as the getcwd remap above -- hush reads $PPID at startup via getppid(). See
 * src/process.rs's do_getppid / modules/native_abi/src/lib.rs in the OxideBSD tree. */
#define __NR_getppid			107
#define __NR_getpgrp			111
#define __NR_setsid				112
