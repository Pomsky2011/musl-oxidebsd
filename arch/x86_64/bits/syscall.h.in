#define __NR_clock_settime			227
/* OxideBSD's own invention (138, continuing right past SYS_UNAME = 137). Matches real
 * clock_gettime(2)'s exact (clockid, timespec_ptr) wire format, so no argument-convention patch
 * was needed beyond this number remap -- musl's own time()/gettimeofday() (src/time/time.c,
 * gettimeofday.c) are both plain C-level wrappers around clock_gettime(CLOCK_REALTIME, ...), not
