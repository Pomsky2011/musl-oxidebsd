/* OxideBSD patch: this file's numbers upstream are real Linux x86_64 syscall numbers. OxideBSD's
 * own native ABI (src/syscall.rs in the OxideBSD tree) has an entirely different, invented-for-
 * itself number space (matching real FreeBSD's long-stable values for the syscalls that were
 * already implemented before this port, plus fresh OxideBSD-only numbers for what's new -- see
 * that file's own module doc comment). Only the entries below that musl's startup/malloc/stdio
 * path for a static binary can actually reach have been remapped to OxideBSD's real registered
 * numbers; everything else keeps its original (inert, unreachable-until-remapped) Linux value --
 * if the linked program ever calls one of those, the kernel logs "unrecognized syscall number"
 * and returns ENOSYS (see src/syscall.rs::dispatch), which is the intended way to discover what
 * to remap/implement next, not a silent miscompile.
 *
 * SYS_open is now remapped to OxideBSD's real SYS_OPEN=5 -- unlike every other remap in this file,
 * the argument conventions genuinely don't match (real open() passes a null-terminated C string
 * plus (flags, mode); OxideBSD's SYS_OPEN takes (path_ptr, path_len, flags), no null terminator
 * requirement, no mode argument -- see modules/fat32/src/lib.rs's fat32_open in the OxideBSD
 * tree), so remapping the number alone wasn't enough (would misinterpret path_len as flags, flags
 * as mode). src/fcntl/open.c is patched separately to build the actual wire format OxideBSD
 * expects, bypassing this file's normal __sys_open_cp/__syscall3(SYS_open, path, flags, mode)
 * macros entirely -- this remap only matters for making the `SYS_open` macro exist so those
 * (now-unused, for the real open() path) macros keep compiling; open.c never reads it.
 *
 * The stat/fstat/lstat macros below used to keep their original real-Linux values (4/5/6), which
 * numerically collided with the write/open (remapped above)/close macros -- confirmed harmless at
 * the time (nothing ported yet called stat/fstat/lstat), but a real landmine for anything that
 * did. Now remapped to OxideBSD's own real, distinct, registered numbers (SYS_STAT = 127,
 * SYS_FSTAT = 126, SYS_LSTAT = 128 in the OxideBSD tree's src/syscall.rs -- see
 * `modules/oxfs/src/lib.rs`'s `oxfs_stat`/`oxfs_fstat`/`oxfs_lstat`) -- closing that collision,
 * not just documenting it. `src/stat/{stat,fstat,lstat}.c` are patched separately (same "bypass
 * the generic multiplexer" pattern `open.c`/`chdir.c`/`mkdir.c` already established) to build
 * OxideBSD's own `(path_ptr, path_len, buf_ptr)` / `(fd, buf_ptr)` wire formats and write straight
 * into a byte-exact `struct stat`, rather than going through musl's usual `fstatat`/kstat-then-copy
 * indirection -- see `write_stat`'s own doc comment in `modules/oxfs/src/lib.rs` for why no
 * intermediate kstat translation is needed here at all.
 *
 * NOTE FOR FUTURE EDITS: this file's generated public header (obj/include/bits/syscall.h, built by
 * this project's Makefile) is produced by copying this file verbatim, then appending one line per
 * line that contains this file's own internal macro-name prefix (two leading underscores, N, R,
 * trailing underscore -- see the #define lines immediately below for what that looks like), with
 * its first occurrence rewritten to the public prefix. That match is a blind per-line substring
 * search, not comment-aware: a comment line containing the internal prefix gets dumped a second
 * time, bare, outside any comment block -- a real, not hypothetical, "stray backtick"/syntax-error
 * footgun (hit exactly this while first writing the comment above). Never spell that internal
 * prefix out in prose anywhere in this file; refer to macros by their public name instead (as done
 * throughout this file already). */
#define __NR_read				3
#define __NR_write				4
#define __NR_open				5
#define __NR_close				6
#define __NR_stat				127
#define __NR_fstat				126
#define __NR_lstat				128
/* OxideBSD's own invention (148, continuing right past SYS_accept = 147). Real Linux's inert
 * value (7) collides with this ABI's own SYS_WAIT4 -- left unremapped, a real poll() call would
 * have silently landed in wait4's handler instead (the same class of bug this file's own
 * getdents/getdents64 comment, and CLAUDE.md's musl section, both warn about). musl's poll()
 * wrapper (src/select/poll.c) calls a plain 3-argument syscall_cp(SYS_poll, fds, n, timeout) when
 * SYS_poll is defined at all (skipping its own ppoll-based fallback entirely) -- already only 3
 * arguments, landing whole in RDI/RSI/RDX, so no call-site patch was needed. Added to unblock a
 * real DNS resolver: musl's own stub resolver (src/network/res_msend.c) is a real userspace UDP
 * client already built on socket/sendto/recvfrom, but multiplexes retries across nameservers with
 * a real poll() -- src/net/mod.rs's oxidebsd_sys_poll is the kernel-side implementation, checking
 * per-socket receive-queue readiness across udp/tcp/icmp. */
#define __NR_poll				148
#define __NR_lseek				8
/* OxideBSD's own invented mmap. musl's mmap() wrapper always calls __syscall6(SYS_mmap, addr,
 * len, prot, flags, fd, off) -- OxideBSD's ABI only wires 3 argument registers through to a
 * handler (RDI/RSI/RDX; see src/syscall.rs's module doc comment), so only the first three of
 * musl's six ever arrive: addr (RDI, a hint -- ignored, OxideBSD always picks the address),
 * len (RSI, the one argument that actually matters), and prot (RDX, ignored -- every mapped page
 * is unconditionally PRESENT|WRITABLE|USER_ACCESSIBLE, the same "every page WRITABLE regardless"
 * simplification src/module.rs's own loader already uses). fd/off (R8/R9) are entirely unreadable
 * at this ABI's 4-argument width; flags (R10) is technically readable now (unlike when this
 * comment was first written -- R10 became a real argument once SYS_execve needed one, see
 * src/syscall.rs's module doc comment) but mmap's own registered handler still doesn't read it --
 * every mapping unconditionally behaves as anonymous+private, the only case this kernel needs to
 * support for musl's allocator. See src/process.rs's mmap handler in the OxideBSD tree. */
#define __NR_mmap				100
#define __NR_mprotect			10
#define __NR_munmap				101
#define __NR_brk				102
/* OxideBSD's own invention (117), but matches real rt_sigaction(2)'s exact wire format --
 * (sig, const struct k_sigaction *act, struct k_sigaction *oldact, size_t sigsetsize), the same
 * 4-argument shape __libc_sigaction (src/signal/sigaction.c) already builds unconditionally, so
 * remapping the number alone was enough; no argument-convention patch needed the way
 * open()/execve() did. Only signals 1-31 are recognized on the OxideBSD side (no real-time
 * signals) -- see src/process.rs's do_sigaction in the OxideBSD tree. */
#define __NR_rt_sigaction		117
/* OxideBSD's own invention (118) -- matches real rt_sigprocmask(2)'s exact
 * (how, set, oldset, sigsetsize) wire format, same story as rt_sigaction above. See
 * src/syscall.rs's sys_sigprocmask in the OxideBSD tree. */
#define __NR_rt_sigprocmask		118
/* OxideBSD's own invention (119). Not actually reached through this header at all --
 * src/signal/x86_64/restore.s hardcodes its own syscall number literal directly (real Linux's
 * restorer stubs all do this, across every arch; none read this macro at all), so that file is
 * patched separately (mov $119, %rax) to match. Kept in sync here anyway so any *future* C code
 * that does reference the rt_sigreturn number sees the right value. See src/syscall.rs's
 * do_sigreturn in the OxideBSD tree -- it bypasses this ABI's normal dispatch-table lookup entirely, since a
 * sigreturn must restore the interrupted context's own saved carry flag verbatim, which the
 * normal Ok(value)/Err(errno) convention can only ever force to one fixed polarity. */
#define __NR_rt_sigreturn		119
/* OxideBSD's own invention (124), continuing the sequence right past getpgid (121, with 122/123
 * reserved for a future clock/nanosleep pass -- see CLAUDE.md's BusyBox gap analysis). Only a
 * handful of tty-specific requests are actually implemented (TCGETS, the TCSETS family,
 * TIOCGWINSZ, TIOCSWINSZ) -- everything else comes back ENOTTY, same as a real driver would for an
 * unrecognized tty ioctl. Request codes themselves (e.g. TCGETS, still 0x5401 below) are real
 * Linux/generic values, unchanged -- only the syscall number itself needed remapping, not the
 * argument shape, since (fd, request, argp) already matches this ABI's own convention. Left at its
 * original value (16) this was simply inert -- nothing else in this invented-number sequence
 * (1-59, then 100 onward) ever used 16, so no collision existed either way; remapped anyway for
 * the same reason every other syscall this port actually implements gets a real number instead of
 * silently ENOSYS-ing forever. See src/syscall.rs's sys_ioctl in the OxideBSD tree. */
#define __NR_ioctl				124
#define __NR_pread64			17
#define __NR_pwrite64			18
/* OxideBSD's own invention (153, continuing right past SYS_shutdown = 152). musl's entire stdio
 * *read* path goes through readv, not plain read, whenever a FILE* has real internal buffering
 * (src/stdio/__stdio_read.c -- a 2-iovec scatter-read: the caller's own buffer plus musl's own
 * internal FILE buffer) -- the exact same "musl doesn't call the simpler syscall you'd expect"
 * story writev already told below, just found much later: nothing had exercised a *buffered*
 * fread()/fgets() call against a real, slow-arriving data source until BusyBox's wget actually
 * downloaded a real file over HTTPS (confirmed live -- the whole TLS/TCP fix chain worked, real
 * response bytes came through, then this surfaced on the very next buffered read). See
 * src/syscall.rs's sys_readv in the OxideBSD tree. */
#define __NR_readv				153
/* OxideBSD's own invention, added specifically because musl's entire stdio write path
 * (src/stdio/__stdio_write.c) goes through writev, never plain write -- discovered the hard way:
 * left unmapped (at Linux's original value, 20), this collided with OxideBSD's own
 * SYS_GETPID=20, so printf() silently called getpid() instead of ever writing anything, no
 * crash, just no output at all. See src/syscall.rs's sys_writev in the OxideBSD tree. */
#define __NR_writev				104
#define __NR_access				21
/* OxideBSD's own invention -- but matches real pipe(2)'s exact wire format (a single pointer to
 * int pipefd[2]), so remapping the number alone was enough; no argument-convention patch needed
 * the way open()/execve() did. See src/syscall.rs's sys_pipe / src/pipe.rs in the OxideBSD tree --
 * added once sh (BusyBox's hush) needed real pipeline (`cmd1 | cmd2`) support. */
#define __NR_pipe				105
#define __NR_select				23
#define __NR_sched_yield		24
#define __NR_mremap				25
#define __NR_msync				26
#define __NR_mincore			27
#define __NR_madvise			28
#define __NR_shmget				29
#define __NR_shmat				30
#define __NR_shmctl				31
/* OxideBSD's own invention (125), continuing the sequence right past ioctl (124). Matches real
 * dup(2)'s exact single-argument (oldfd) wire format, same story as dup2 below. Added once
 * CONFIG_HUSH_JOB turned out to need it (hush's own dup_CLOEXEC helper falls back to plain dup()
 * once fcntl(F_DUPFD_CLOEXEC) -- itself unimplemented, harmlessly ENOSYS -- fails). Left at its
 * original value (32) this was simply inert, same story ioctl's own original value (16) had. See
 * src/fd.rs's dup in the OxideBSD tree. */
#define __NR_dup				125
/* OxideBSD's own invention -- matches real dup2(2)'s exact (oldfd, newfd) wire format, same story
 * as the pipe entry above. See src/syscall.rs's sys_dup2 / src/fd.rs's dup2 in the OxideBSD tree. */
#define __NR_dup2				106
#define __NR_pause				34
/* OxideBSD's own invention (139, continuing right past SYS_CLOCK_GETTIME = 138). Matches real
 * nanosleep(2)'s exact (req_ptr, rem_ptr) wire format -- musl's own nanosleep(), calling through
 * __clock_nanosleep(CLOCK_REALTIME, 0, req, rem), reduces to exactly this shape whenever
 * flags == 0 (the common case), so only the number needed remapping. See src/process.rs's
 * do_nanosleep in the OxideBSD tree -- a real block-then-schedule(), woken by the timer IRQ
 * handler once the requested tick deadline passes, not a busy-wait. */
#define __NR_nanosleep			139
#define __NR_getitimer			36
#define __NR_alarm				37
#define __NR_setitimer			38
#define __NR_getpid				20
#define __NR_sendfile			40
/* OxideBSD's own invention (140, continuing right past SYS_NANOSLEEP = 139). UDP only so far
 * (see modules/net/src/lib.rs and src/net/udp.rs in the OxideBSD tree) -- connect/accept/listen
 * below stay unmapped until a later phase adds TCP. socket(domain, type, protocol) needed no
 * argument-convention patch: __socketcall's own x86_64 fallback (this file's __alt_socketcall,
 * src/internal/syscall.h) already resolves to a plain direct syscall with the unused 4th/5th/6th
 * slots as literal zeros, which lands exactly on this ABI's own (domain, type, protocol, _unused)
 * 4-argument shape with no call-site changes needed. */
#define __NR_socket				140
/* OxideBSD's own invention (145, continuing right past SYS_setsockopt = 144 -- TCP's three new
 * syscalls picked up the sequence in the order they were added, same story as SYS_bind's own
 * out-of-numeric-order placement above). Unlike sendto/recvfrom, connect(fd, addr, len) needed no
 * call-site patch: it's already only a 3-argument call, landing entirely within RDI/RSI/RDX with
 * nothing left over for %r8/%r9 to swallow. */
#define __NR_connect			145
/* OxideBSD's own invention (147). Same story as SYS_connect above -- accept(fd, addr, addrlen) is
 * only 3 arguments, all of them reach this ABI's registers untouched, so the kernel-side handler
 * (src/net/tcp.rs's oxidebsd_sys_accept in the OxideBSD tree) can read `addr`/`addrlen` directly
 * and write both outputs itself -- no reduction like SYS_recvfrom's `alen`-dropping trick needed
 * here. */
#define __NR_accept				147
/* OxideBSD's own invention (142). Real sendto(fd, buf, len, flags, addr, alen) is a 6-argument
 * call -- musl's own __socketcall_cp places its 5th/6th arguments (addr, alen) in %r8/%r9, both
 * unreachable at this ABI's 4-register width (RDI/RSI/RDX/R10; see src/syscall.rs's module doc
 * comment in the OxideBSD tree), the same class of gap SYS_open's own remap comment above
 * documents. src/network/sendto.c is patched separately to put `addr` in the call's 4th slot
 * (R10) in `flags`' place instead -- no MSG_* flag is meaningful here yet, and `alen` is dropped
 * entirely since AF_INET (the only family this phase supports) always means a fixed 16-byte
 * `struct sockaddr_in`, so the kernel-side handler in src/net/udp.rs doesn't need it as a
 * separate wire argument. */
#define __NR_sendto				142
/* OxideBSD's own invention (143) -- same story as SYS_sendto above, same call-site patch shape
 * (src/network/recvfrom.c puts `addr` in R10's slot in `flags`' place; `alen` is dropped from the
 * wire, with the patched wrapper writing sizeof(struct sockaddr_in) into the caller's *alen
 * itself once the syscall returns, since that value is a fixed compile-time constant here, not
 * something the kernel needs to compute). */
#define __NR_recvfrom			143
#define __NR_sendmsg			46
#define __NR_recvmsg			47
/* OxideBSD's own invention (152, continuing right past SYS_socketpair = 149 -- 150/151 went to
 * set_tid_address/fcntl below first). shutdown()'s own wrapper (src/network/shutdown.c) goes
 * through the same __alt_socketcall x86_64 fallback socket()/socketpair() above already use: a
 * plain direct syscall(fd, how, 0, 0, 0, 0), landing whole within 2 argument registers -- no
 * call-site patch needed. Real semantics only exist for a crate::pipe-backed AF_UNIX socketpair
 * endpoint (a real half-close: SHUT_WR marks that direction's buffer closed without tearing down
 * the fd, so the peer still sees EOF once drained, but writes into it now fail) -- ENOTSOCK for
 * anything else (a TCP/UDP socket, a plain pipe end, an oxfs file). Added to unblock BusyBox's
 * `wget` HTTPS path: wget.c calls shutdown(fileno(sfp), SHUT_WR) after sending the request, on
 * exactly this kind of socketpair endpoint (see CLAUDE.md's "Real networking" known-gaps entry). */
#define __NR_shutdown			152
/* OxideBSD's own invention (141, continuing right past SYS_recvfrom = 143 -- picked before it in
 * the sequence for no reason beyond "this is the order these five got added in"). Matches real
 * bind(2)'s exact (fd, addr, len) wire format -- already only 3 arguments, so no call-site patch
 * was needed the way sendto/recvfrom above required. */
#define __NR_bind				141
/* OxideBSD's own invention (146). Same story as SYS_connect above -- listen(fd, backlog) is only
 * 2 arguments, no reduction needed. */
#define __NR_listen				146
#define __NR_getsockname		51
#define __NR_getpeername		52
/* OxideBSD's own invention (149, continuing right past SYS_poll = 148). Real Linux's inert value
 * (53) is left unremapped/unused -- no collision risk the way getdents/poll had, it just never
 * pointed anywhere real before. musl's socketpair() wrapper (src/network/socketpair.c) goes
 * through the same __alt_socketcall x86_64 fallback socket()/bind()/connect() above already use:
 * a plain direct syscall(domain, type, protocol, fd, 0, 0), unused 5th/6th slots as literal
 * zeros, landing whole within this ABI's 4-register width (RDI/RSI/RDX/R10) -- no call-site patch
 * needed, same story as SYS_socket's own comment above. Added specifically to unblock BusyBox's
 * `wget` HTTPS path: its spawn_ssl_client (networking/wget.c) forks a TLS-helper child and hands
 * it the network fd over a local AF_UNIX/SOCK_STREAM socketpair, with no fallback if one doesn't
 * exist -- see CLAUDE.md's own "Real networking" known-gaps entry. */
#define __NR_socketpair			149
/* OxideBSD's own invention (144). Real setsockopt(fd, level, optname, optval, optlen) is a
 * 5-argument call -- its 5th argument (optlen) lands in %r8, unreachable at this ABI's 4-register
 * width, same class of gap as sendto/recvfrom above. No call-site patch was needed to work around
 * it, though: src/net/udp.rs's handler is a no-op stub for this phase (validates the fd is a real
 * socket, does nothing else), so it never needed to see optval's content or length in the first
 * place -- (fd, level, optname) in RDI/RSI/RDX is already everything it reads. */
#define __NR_setsockopt			144
#define __NR_getsockopt			55
#define __NR_clone				56
/* _Fork() (src/process/_Fork.c) prefers plain SYS_fork (a no-arg fork, exactly OxideBSD's own
 * SYS_FORK=2) over SYS_clone whenever SYS_fork is defined -- true here, so SYS_clone/SYS_vfork
 * are never reached by musl's own fork() and are left unmapped (real `clone(2)`-with-flags
 * semantics don't exist on OxideBSD at all yet). */
#define __NR_fork				2
#define __NR_vfork				58
/* Numerically unchanged from upstream (59 happens to already be OxideBSD's real SYS_EXECVE), but
 * NOT actually argument-compatible yet, same category of gap as SYS_open above: musl's execve()
 * passes (path, argv, envp) in RDI/RSI/RDX; OxideBSD's SYS_EXECVE (src/process.rs::do_execve)
 * expects (path_ptr, path_len) -- no argv/envp support at all yet. Unreachable for now since
 * nothing in this port's own test programs calls execve() on itself (only stsh, over the native
 * ABI it already speaks correctly, execve's *other* programs) -- flagged here so remapping the
 * number doesn't read as "this was verified to work." */
#define __NR_execve				59
/* exit()/_Exit() (src/exit/_Exit.c) call SYS_exit_group first, falling back to a SYS_exit loop
 * only if that somehow returns (it never does, on a real kernel or on OxideBSD) -- both get
 * OxideBSD's one real SYS_EXIT=1, since this kernel's process model has no separate "just this
 * thread" vs "whole process" exit distinction to preserve (no threads exist at all yet). */
#define __NR_exit				1
#define __NR_wait4				7
/* OxideBSD's own invention (116), but matches real kill(2)'s exact (pid, sig) wire format, same
 * "no argument-convention patch needed" story as rt_sigaction/rt_sigprocmask above. Only a
 * positive pid (no process-group/broadcast targeting) and signals 1-31 are supported on the
 * OxideBSD side -- see src/process.rs's do_kill in the OxideBSD tree. */
#define __NR_kill				116
/* OxideBSD's own invention (137, continuing right past SYS_MKDIR = 136 above). Matches real
 * uname(2)'s exact single-pointer wire format (musl's own uname() -- src/misc/uname.c -- is just
 * syscall(SYS_uname, uts), no derived-argument computation from the pointer the way open()'s
 * strlen needed), so no argument-convention patch was needed beyond this number remap. See
 * src/syscall.rs's sys_uname in the OxideBSD tree. */
#define __NR_uname				137
#define __NR_semget				64
#define __NR_semop				65
#define __NR_semctl				66
#define __NR_shmdt				67
#define __NR_msgget				68
#define __NR_msgsnd				69
#define __NR_msgrcv				70
#define __NR_msgctl				71
/* OxideBSD's own invention (151). musl's fcntl() wrapper (src/fcntl/fcntl.c) is variadic in C but
 * always resolves to a plain 3-argument syscall(SYS_fcntl, fd, cmd, arg) for every command this
 * kernel implements (F_GETFL/F_SETFL/F_SETFD/F_DUPFD/F_DUPFD_CLOEXEC) -- already only 3 arguments,
 * no call-site patch needed. Only enough of real fcntl(2) to cover what BusyBox's own
 * libbb/xfuncs.c (ndelay_on/ndelay_off/close_on_exec_on) and musl's own F_DUPFD_CLOEXEC fallback
 * dance actually call; everything else is EINVAL. Added to unblock BusyBox's `wget` HTTPS path
 * (its progress-bar/timeout loop wants real O_NONBLOCK on the response stream) -- see CLAUDE.md's
 * "Real networking" known-gaps entry and src/syscall.rs's own sys_fcntl doc comment for the full
 * story on what's actually implemented. */
#define __NR_fcntl				151
#define __NR_flock				73
#define __NR_fsync				74
#define __NR_fdatasync			75
#define __NR_truncate			76
#define __NR_ftruncate			77
/* OxideBSD's own invention (129, continuing right past SYS_LSTAT = 128 -- see
 * modules/oxfs/src/lib.rs's own doc comment in the OxideBSD tree). Matches real getdents(2)'s own
 * wire format exactly (fd, buf, count) -> byte count written, 0 at EOF -- no argument-convention
 * patch needed the way stat/open/chdir needed (see src/stat/stat.c's own comment on this same
 * branch), since there's no string argument here to mismatch. readdir() (src/dirent/readdir.c)
 * is the only caller in a static binary's own startup/stdio path that reaches this -- it calls
 * this macro's own name, but src/internal/syscall.h has its own override sitting on top of both
 * this and the 64-bit entry below (`#ifdef SYS_getdents64 / #undef SYS_getdents / #define
 * SYS_getdents SYS_getdents64`, unconditionally preferring the 64-bit name whenever it's defined
 * at all) -- so leaving the 64-bit entry at its original, inert, real-Linux value silently
 * resurrected the exact numeric collision this remap exists to close (confirmed live: `ls` ran
 * clean but every real `readdir()` call inside it reached "unrecognized syscall number 217", not
 * this macro's own 129, since 217 is what `SYS_getdents` actually expanded to once that override
 * fired). Both this entry and the 64-bit one below must carry OxideBSD's own real number, kept in
 * sync, or this reintroduces itself the moment either one drifts. */
#define __NR_getdents			129
/* OxideBSD's own invention (108, not a FreeBSD-authentic number -- added once porting sh (BusyBox's
 * hush) surfaced it as unrecognized: hush's cd/prompt logic calls real getcwd()). Matches real
 * getcwd(2)'s own wire format exactly (buf, size) -> byte count including NUL, or -ERANGE if size
 * is too small, so no argument-convention patch was needed on the musl side, same story as
 * pipe/dup2 below. See modules/fat32/src/lib.rs's sys_getcwd in the OxideBSD tree. */
#define __NR_getcwd				108
/* Remapped to OxideBSD's real SYS_CHDIR=12 (modules/fat32/src/lib.rs's sys_chdir in the OxideBSD
 * tree, already implemented well before this port -- just never remapped here until hush's own
 * `cd` builtin surfaced the gap). Matches chdir(2)'s own (path) wire format exactly. */
#define __NR_chdir				12
#define __NR_fchdir				81
/* OxideBSD's own invention (111, not a Linux/FreeBSD-authentic number -- unlike SYS_chdir/SYS_mkdir
 * above, this one never existed as a mapped, reachable syscall before this: no filesystem module
 * implemented rename() until modules/oxfs replaced modules/fat32). Wire format is (old_ptr,
 * old_len, new_ptr, new_len) -- all four of this ABI's argument registers, the same "R10 becomes a
 * real argument" precedent execve's envp_ptr set. src/stdio/rename.c is patched separately to
 * build that shape (real rename() passes two plain null-terminated strings, no lengths). See
 * modules/oxfs/src/lib.rs's sys_rename in the OxideBSD tree. */
#define __NR_rename				111
/* Remapped to OxideBSD's real SYS_MKDIR=136 (modules/fat32/src/lib.rs's sys_mkdir in the OxideBSD
 * tree), for the same reason and at the same time as the SYS_chdir remap above. */
#define __NR_mkdir				136
/* OxideBSD's own invention (110) -- same story as SYS_rename above: never mapped/reachable before
 * modules/oxfs. Wire format is (path_ptr, path_len), same convention as SYS_chdir/SYS_mkdir --
 * src/unistd/rmdir.c is patched to compute path_len via strlen(). */
#define __NR_rmdir				110
#define __NR_creat				85
#define __NR_link				86
/* OxideBSD's own invention (109) -- same story as SYS_rmdir above. src/unistd/unlink.c is patched
 * to compute path_len via strlen(). The removed directory entry's inode/blocks are not freed
 * (modules/oxfs, like every other allocator in this codebase, never reclaims) -- see
 * modules/oxfs/src/lib.rs's sys_unlink in the OxideBSD tree. */
#define __NR_unlink				109
#define __NR_symlink			88
